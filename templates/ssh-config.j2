# {{ ansible_managed }}
# Added by OrbStack: 'orb' SSH host for Linux machines.
# Must remain at the top of ssh_config (before any Host blocks) to take
# effect. This won't be added again if you remove it.
Include ~/.orbstack/ssh/config

Include {{ ansible_facts['env']['HOME'] }}/.colima/ssh_config
Host *
        StrictHostKeyChecking no
{% if ssh_identity_agent | default('') != '' %}
        IdentityAgent "{{ ssh_identity_agent }}"
{% endif %}
