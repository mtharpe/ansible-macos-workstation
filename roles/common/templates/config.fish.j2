# {{ ansible_managed }}
# Fish shell configuration

# Source system/done configurations
if test -f ~/.config/fish/system.fish
    source ~/.config/fish/system.fish
end

# Prefer GNU coreutils, findutils, grep, sed, tar, awk, gzip from Homebrew
set -l brew_prefix (brew --prefix 2>/dev/null || echo "/opt/homebrew")
for pkg in coreutils findutils gnu-sed gnu-tar grep gawk gzip
    set -l gnubin "$brew_prefix/opt/$pkg/libexec/gnubin"
    if test -d $gnubin
        if not contains $gnubin $PATH
            set -p PATH $gnubin
        end
    end
end

# Add ~/.local/bin to PATH
if test -d ~/.local/bin
    if not contains -- ~/.local/bin $PATH
        set -p PATH ~/.local/bin
    end
end

# Docker / OrbStack
# OrbStack provides the socket at /var/run/docker.sock; the orbstack context is
# used instead of DOCKER_HOST. Erase any stray DOCKER_HOST (e.g. leftover from a
# removed Colima install) so docker uses the active context.
set -e DOCKER_HOST

# Abbreviations
abbr -a python python3

# Aliases
alias c='clear'
alias ls='eza -l --group-directories-first --git'
alias ll='eza -l --icons --git'
alias la='eza -la --icons --git'
alias lt='eza --tree --level=2 --icons'
alias sum="shasum -a 256"
alias ssh_keygen="ssh-keygen -b 4096 -C (date +%Y-%m-%d)"
alias vault_login='vault login -method=userpass username={{ local_user }}'

# `git pull` in every git repo under CWD (up to 4 dirs deep).
function git_all --description "git pull in every repo under CWD"
    printf '\n'
    for gitdir in (find . -maxdepth 4 -type d -name .git)
        set -l repo (dirname $gitdir)
        set_color blue
        realpath $repo
        set_color normal
        git -C $repo pull
    end
end

# Terraform project scaffold
function tfnew --description "Create a new Terraform project directory and files"
    if test (count $argv) -eq 0
        echo "Usage: tfnew <directory_name>"
        return 1
    end

    set dir_name $argv[1]

    if test -d $dir_name
        echo "Error: Directory '$dir_name' already exists."
        return 1
    end

    mkdir $dir_name
    touch $dir_name/main.tf
    touch $dir_name/variables.tf
    touch $dir_name/outputs.tf
    touch $dir_name/.gitignore

    echo ".terraform/" >> $dir_name/.gitignore
    echo "*.tfstate" >> $dir_name/.gitignore
    echo "*.tfstate.backup" >> $dir_name/.gitignore
    echo "*.tfvars" >> $dir_name/.gitignore

    cd $dir_name
    echo "Terraform project '$dir_name' created successfully."
end

# Prompt + tooling integrations. starship reads ~/.config/starship.toml,
# rendered from roles/common/templates/starship.toml.j2 (mirror of the
# Fedora repo's templates/starship.toml so both machines look the same).
if type -q starship
    starship init fish | source
end

if type -q direnv
    direnv hook fish | source
end

# Added by OrbStack: command-line tools and integration
if test -f ~/.orbstack/shell/init2.fish
    source ~/.orbstack/shell/init2.fish 2>/dev/null
end

# SSH Agent integration
{% if ssh_identity_agent | default('') != '' %}
set -gx SSH_AUTH_SOCK (string replace -r '^~' "$HOME" "{{ ssh_identity_agent }}")
{% endif %}
